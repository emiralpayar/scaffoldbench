node_modules/
dist/
.next/
out/
*.tsbuildinfo

.env
.env.local
.DS_Store

# Traces are large; keep them out of git by default. The run summaries in
# results/<runSet>/runs/ are committed, which is everything the leaderboard
# needs. Commit a trace deliberately when it illustrates something.
results/*/traces/
# The synthetic demo set is the exception: its traces are what let someone
# review the trace viewer without running a benchmark.
!results/demo-synthetic/traces/
# The first full run set's traces are the evidence for docs/POSTMORTEM.md and
# the site's /postmortem page: they are the only place the empty plans, the
# denied StructuredOutput calls and the claude.ai connectors are visible.
!results/2026-07-25T20-18-35Z-3fs5/traces/
# The flagship run set's traces stay local (about 106 MB), except a handful the
# site replays and links as illustrations: the landing page's race (one Haiku
# task, all six designs), a propose-select win over the single agent, and a
# plan-execute-verify run its revision round fixed.
!results/scaffold-or-scale-v1/traces/
results/scaffold-or-scale-v1/traces/*
!results/scaffold-or-scale-v1/traces/claude-haiku-4-5-20251001__*__airline-hard__r1.jsonl
!results/scaffold-or-scale-v1/traces/claude-haiku-4-5-20251001__single__airline-easy__r1.jsonl
!results/scaffold-or-scale-v1/traces/claude-haiku-4-5-20251001__propose-select__airline-easy__r1.jsonl
!results/scaffold-or-scale-v1/traces/claude-sonnet-5-5__plan-execute-verify__ecommerce-hard__r1.jsonl
