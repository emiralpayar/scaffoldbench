{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@scaffoldbench/core": ["packages/core/src/index.ts"],
      "@scaffoldbench/core/*": ["packages/core/src/*"],
      "@scaffoldbench/strategies": ["packages/strategies/src/index.ts"],
      "@scaffoldbench/strategies/*": ["packages/strategies/src/*"],
      "@scaffoldbench/tasks": ["packages/tasks/src/index.ts"],
      "@scaffoldbench/tasks/*": ["packages/tasks/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/cli/src/**/*.ts",
    "apps/cli/test/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "apps/web/.next", "**/dist"]
}
