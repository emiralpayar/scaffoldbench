{
  "name": "scaffoldbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A benchmark lab that measures agent harness architectures on the same task set.",
  "author": "Emir Alp Ayar",
  "homepage": "https://github.com/emiralpayar/scaffoldbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emiralpayar/scaffoldbench.git"
  },
  "bugs": {
    "url": "https://github.com/emiralpayar/scaffoldbench/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "bench": "tsx apps/cli/src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:web": "npm run dev --workspace @scaffoldbench/web",
    "build:web": "npm run build --workspace @scaffoldbench/web",
    "check": "npm run typecheck && npm run typecheck --workspace @scaffoldbench/web && npm run test",
    "check:wiring": "tsx scripts/check-wiring.ts",
    "demo:data": "tsx scripts/generate-demo-data.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "zod": "^4.4.3"
  }
}
