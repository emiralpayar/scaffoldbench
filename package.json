{
  "name": "agent-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A benchmark lab that measures agent harness architectures on the same task set.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "arena": "tsx apps/cli/src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:web": "npm run dev --workspace @arena/web",
    "build:web": "npm run build --workspace @arena/web",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "zod": "^4.4.3"
  }
}
