# Required to run benchmarks or the live demo.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: default model for benchmark sweeps.
# Use claude-sonnet-5 for cheap iteration, claude-opus-5 for headline numbers.
ARENA_MODEL=claude-opus-5

# Optional: hard ceiling (USD) for a single agent run. The runner aborts past this.
ARENA_MAX_COST_USD=1.00
